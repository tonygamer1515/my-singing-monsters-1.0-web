<template name="template_likesentry">
	
	<size w="80*(lua_sys.screenWidth()/480.0)" h="110*(lua_sys.screenHeight()/320.0)" />
	
	<aeComponent name="Sprite">
		<position relativeTo="element:name()" vAnchor="BOTTOM" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="-70*game.hudScale()" priorityOffset="0" />
		<event name="onInit" params="component, element">
			<![CDATA[
				component("animationName"):SetString("xml_bin/"..element("AnimFile"):GetString())
				component("animation"):SetString(element("AnimName"):GetString())
				
				component:setScale(Vector2(0.5*(lua_sys.screenWidth()/480.0), 0.5*(lua_sys.screenWidth()/480.0)))
				
				component("layer"):SetString("Clipping")
				
				--element:setOrientationPosition( Vector2( component:size().x / 2.0, component:size().y / 2.0 + 15*(game.hudScale()) ) )
			]]>
		</event>
	</aeComponent>
	
	<event name="hide" params="element">
		element["Sprite"]("visible"):SetInt(0)
	</event>
	
	<event name="show" params="element">
		element["Sprite"]("visible"):SetInt(1)
	</event>
	
