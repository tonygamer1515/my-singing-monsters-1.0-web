		<orientation vAnchor="BOTTOM" hAnchor="LEFT" xOffset="20" yOffset="20*game.hudScale()" priorityOffset="-1" />
		<spriteComponent name="Sprite">
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("gfx/facebook@2x")
				component("size"):SetFloat(0.35*game.hudScale())
				component("layer"):SetString("MidPopUps")
				if(game.isFacebookLoggedIn()) then
					component("alpha"):SetFloat(1.0)
				else
