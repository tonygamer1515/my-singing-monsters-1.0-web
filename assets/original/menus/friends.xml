	<element name="FriendsList">
		<size w="300*game.hudScale()" h="150*game.hudScale()" />
		<position relativeTo="Frame" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="-28*game.hudScale()" priorityOffset="0" />
		<swipeComponent name="Swiper">
			<event name="onPostInit" params="component, element">
				component:DoStoredScript("refresh")				
			</event>
			
			<function name="refresh" params="component, element">
				component:GetVar("direction"):SetInt(1)
				component:GetVar("mode"):SetInt(1)
				component:GetVar("tSteps"):SetFloat(25.0)
				component:listenToTouches(element)
				
				local numItems = element("NumEntries"):GetInt()
				
				if(numItems &gt; 0) then
				
					local itemHeight = element:GetElement("friendentry0"):absH()
				
					if(numItems * itemHeight &gt; element:absH()) then
						component:setScrollSize((numItems*itemHeight)-element:absH())
					else
						component:setScrollSize(0)
					end
				
				end
			</function>
			
			<event name="onTick" params="component, element, dt">		
				if(element("NumEntries"):GetInt() &gt; 0) then
					if(element:parent()["ScrollMarker"]("draggingMarker"):GetInt() == 0) then
						local offset = component:scrollOffset()
						local first = element:GetElement("friendentry0")
						local scrollMarker = element:parent():GetElement("ScrollMarker")
						local scrollBar = element:parent():GetElement("ScrollBar")
						local markerBookend = scrollBar("BookendSize"):GetInt()
						if first then
							if ( first:getOrientationPosition().y ~= offset ) then
								first:setOrientationPosition(Vector2(first("xOffset"):GetInt(), offset))
								local markerOffset = markerBookend + (scrollBar:absH() - (2*markerBookend))*((-1)*offset/component:scrollSize())
								markerOffset = clamp(markerOffset, markerBookend, (scrollBar:absH() - (2.25*markerBookend)))
								scrollMarker("yOffset"):SetInt(markerOffset)
							end
						end
					end
				end
			</event>
		</swipeComponent>
		<touchComponent name="Touch">
			<size dependentOnElement="element:name()" />					
			<event name="onInit" params="component, element">
				component("singleTouch"):SetInt(1)
			</event>					
		</touchComponent>
		<event name="onInit" params="element">
			game.setClipping("Clipping", 0, element:absY()*lua_sys.deviceScaleY(), lua_sys.screenWidth()*lua_sys.deviceScaleY(), element:absH()*lua_sys.deviceScaleY())
			element:DoStoredScript("populate")
		</event>
		<event name="populate" params="element">
			<![CDATA[
			local friendKeys = game.getFriendKeys()
			local numItems = friendKeys:size()
			local previous = nil
			
			element("NumEntries"):SetInt(numItems)
			
			for i=0,numItems-1 do
				
				local friendData = game.getFriend(friendKeys[i])
				
				local friendEntry = menu:addTemplateElement("template_friendsentry", "", element)
				
				friendEntry("DisplayName"):SetString(friendData:displayName())
				friendEntry("Level"):SetInt(friendData:level())
				friendEntry("UserId"):SetInt(friendData:userId())
				friendEntry("entryNum"):SetInt(i)
				
				friendEntry:setName("friendentry"..i)
				
				if(previous == nil) then
					friendEntry:relativeTo(element)
					friendEntry:setOrientation(lua_sys.MenuOrientation(0, 0, -1, lua_sys.HCENTER, lua_sys.TOP))
					friendEntry:setRelativeObjectAnchors(lua_sys.HCENTER, lua_sys.TOP)
				else
					friendEntry:relativeTo(previous)
					friendEntry:setOrientation(lua_sys.MenuOrientation(0, 0, 0, lua_sys.HCENTER, lua_sys.TOP))
					friendEntry:setRelativeObjectAnchors(lua_sys.HCENTER, lua_sys.BOTTOM)
				end
				
				previous = friendEntry
				
				friendEntry:init()
				friendEntry:setPositionBroadcast(true)
				
			end
		]]>
		</event>
	</element>
	
