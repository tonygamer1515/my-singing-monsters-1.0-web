				end
			</event>
		</spriteComponent>
		<textComponent name="Label">
			<size w="100*(lua_sys.screenWidth()/480.0)" h="50*(lua_sys.screenHeight()/320.0)" />
			<position relativeTo="element:name()" component="Sprite" vAnchor="BOTTOM" hAnchor="LEFT" />
			<orientation vAnchor="TOP" hAnchor="LEFT" xOffset="0" yOffset="-5*(lua_sys.screenHeight()/320.0)" priorityOffset="0" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(0)
				component("font"):Set(game.getTextFont())
				component("size"):SetFloat(0.22*(lua_sys.screenWidth()/480.0))
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_LEFT_ALIGNED)
				component("textPadding"):SetInt(9)
				component("autoScale"):SetInt(1)
				component("layer"):SetString("MidPopUps")
				if(game.isFacebookLoggedIn()) then
					component("alpha"):SetFloat(1.0)
					component("text"):SetString("LOGGED_IN")
				else
					component("alpha"):SetFloat(0.5)
					component("text"):SetString("LOGGED_OUT")
				end
			</event>
		</textComponent>
		<touchComponent name="Touch">
			<size dependentOnElement="element:name()" dependentOnComponent="Sprite" />
			<position relativeTo="element:name()" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priorityOffset="0" />
			<event name="onTouchDown" params="component, element">
				element["Sprite"]("alpha"):SetFloat(0.25)
				element["Label"]("alpha"):SetFloat(0.5)
			</event>
			<event name="onTouchUp" params="component, element">
				if(game.isFacebookLoggedIn()) then
					game.loginFacebook(false)
				else
					game.loginFacebook(true)
				end
			</event>
			<event name="onTouchRelease" params="component, element">
				if(game.isFacebookLoggedIn()) then
					element["Sprite"]("alpha"):SetFloat(1.0)
				else
					element["Sprite"]("alpha"):SetFloat(0.5)
				end
			</event>
		</touchComponent>
	</element>
	
