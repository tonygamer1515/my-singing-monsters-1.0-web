	<template type="template_overlayedcheckbox" name="ZoomRangeBox">
		<templateVar name="$overlaySprite" equals="'button_yes'" />
		<templateVar name="$bgSprite" equals="'button_base_grey'" />
		<templateVar name="$sheetName" equals="'xml_resources/buttons01.xml'" />
		<templateVar name="$scale" equals="0.25*game.hudScale()" />
		<templateVar name="$layer" equals="'MidPopUps'" />
		<templateVar name="$check" equals="game.isZoomRangeFull()" />
		<position relativeTo="PushNotificationsBox" vAnchor="BOTTOM" hAnchor="VCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="10" priorityOffset="0" />
		<touchComponent name="Touch">
			<event name="onTouchUp" params="component, element">
				onTouchUp(component, element)
				game.toggleZoomRange()
				if(game.isZoomRangeFull()) then
					element["overlay"]("visible"):SetInt(0)
				else
					element["overlay"]("visible"):SetInt(1)
				end
			</event>
		</touchComponent>
		<event name="onInit" params="element">
			if game.hudScale() ~= 1 then
				element:DoStoredScript("hide")
			end
		</event>
	</template>
	
