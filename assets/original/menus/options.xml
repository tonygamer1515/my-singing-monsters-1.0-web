	<element name="ZoomRangeLabel">
		<hudScale scale="game.hudScale()" />
		<size dependentOnElement="element:name()" dependentOnComponent="Text" />
		<position relativeTo="ZoomRangeBox" vAnchor="VCENTER" hAnchor="LEFT" />
		<orientation vAnchor="VCENTER" hAnchor="RIGHT" xOffset="6" yOffset="0" priorityOffset="0" />
		<textComponent name="Text">
			<size w="150*game.hudScale()" h="35*(lua_sys.screenHeight()/320.0)" />
			<event name="onInit" params="component, element">
				component("multiline"):SetInt(1)
				component("font"):Set(game.getTextFont())
				component("size"):SetFloat(0.22)
				component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_LEFT_ALIGNED)
				component("text"):SetString("OPTION_INCREASE_ZOOM_RANGE")
				component("autoScale"):SetInt(1)
				component("layer"):SetString("MidPopUps")
				
				if game.hudScale() ~= 1 then
