<?xml version="1.0" encoding="utf-16"?>
<menu>

	<element name="TopElement">
	
		<hudScale scale="lua_sys.screenWidth()/960.0" />
	
		<size dependentOnElement="Sprite"/>
		<position relativeTo="SCREEN" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priority="0" />
		
		<touchComponent name="Touch">
			<size dependentOnElement="element:name()"/>
		</touchComponent>		
		
		<spriteComponent name="Sprite">
			<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priority="10" />
		
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("gfx/menu/logging_in")
				component("layer"):SetString("Loading")
			</event>
		</spriteComponent>
		
		<element name="LoaderElement">
			<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="13" yOffset="9" priority="7" />
			<size dependentOnElement="LoaderBG"/>
			
			<spriteComponent name="Loader" >
				<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
				<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priority="0" />
				
				<event name="onInit" params="component, element" >
					component("spriteName"):SetString("gfx/menu/loading_bar_full")
					component("layer"):SetString("Loading")
				</event>
			</spriteComponent>
			
		</element>
		
		<event name="updateLoader" params="element, completion, state">
			<![CDATA[
			local loader = element:GetElement("LoaderElement"):GetComponent("Loader")
			local height = loader("height"):GetInt()
			
			if ( state == 0 ) then
				loader("maskY"):SetFloat( height )
				loader("maskH"):SetFloat( 0 )
				loader("yOffset"):SetFloat( height )
			elseif ( state == 1 ) then
				local maskH = ( height * ( completion * 0.25 ) )
				loader("maskY"):SetFloat( height - maskH )
				loader("maskH"):SetFloat( maskH )
				loader("yOffset"):SetInt( height - maskH )
			elseif ( state == 2 ) then
				local maskH = ( height * ( 0.25 + ( completion * 0.75 ) ) )
				loader("maskY"):SetFloat( height - maskH )
				loader("maskH"):SetFloat( maskH )
				loader("yOffset"):SetInt( height - maskH )
			elseif ( state == 3 ) then
				loader("maskY"):SetFloat( 0 )
				loader("maskH"):SetFloat( height )
				loader("yOffset"):SetInt(0)
			end
			]]>
		</event>
	
	</element>
	
	
	
	<element name="RandomTip">
		<size dependentOnElement="PARENT" dependentOnComponent="Sprite" />
		<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
		<orientation vAnchor="TOP" hAnchor="HCENTER" xOffset="0" yOffset="266*lua_sys.screenWidth()/960.0" priorityOffset="2" />
		
		<spriteComponent name="TipSprite">
			<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="0" priority="-1" />
		
			<event name="onInit" params="component, element">
				component("spriteName"):SetString("gfx/menu/title_tipframe")
				component("layer"):SetString("Loading")
				component("size"):SetFloat(lua_sys.screenWidth()/960.0)
			</event>
		</spriteComponent>
		
		
		<textComponent name="Text">
			<size w="640*lua_sys.screenWidth()/960.0" h="52" />
			<position relativeTo="PARENT" vAnchor="VCENTER" hAnchor="HCENTER" />
			<orientation vAnchor="VCENTER" hAnchor="HCENTER" xOffset="0" yOffset="-5*game.hudScale()" priorityOffset="-2" />
			
			<event name="onInit" params="component, element">
				<![CDATA[				
					component("size"):SetFloat(0.5*lua_sys.screenWidth()/960.0)
					component("autoScale"):SetInt(1)
					component("multiline"):SetInt(1)
					component("font"):Set(game.getTextFont())
					component("alignment"):SetInt(lua_sys.MenuTextComponent_TEXT_HCENTER_ALIGNED)
					component("text"):SetString(game.getRandomTip())
					
					component("layer"):SetString("Loading")
				]]>
			</event>
		</textComponent>
	</element>
		
</menu>